{
	"name": "opsiconfd43-dev",
	"dockerComposeFile": "../docker/opsiconfd-dev/docker-compose.yml",
	"service": "opsiserver43-dev",
	"initializeCommand": ".devcontainer/initialize.sh",
	"postCreateCommand": ".devcontainer/post_create.sh",
	"workspaceFolder": "/workspace",
	"remoteUser": "${localEnv:USER}",
	"overrideCommand": false,
	"customizations": {
		"vscode": {
			"settings": {
				"workbench.colorCustomizations": {
					"activityBar.background": "#3f5aa6",
					"activityBar.foreground": "#cb1e58",
					"activityBar.inactiveForeground": "#e4e4e3"
				},
				"files.trimTrailingWhitespace": true,
				"files.autoSave": "off",
				"editor.formatOnType": true,
				"editor.formatOnPaste": true,
				"editor.formatOnSave": true,
				"[python]": {
					"editor.codeActionsOnSave": {
						"source.fixAll": "explicit",
						"source.organizeImports": "explicit"
					},
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"python.defaultInterpreterPath": ".venv/bin/python3",
				"python.languageServer": "Pylance",
				"python.terminal.activateEnvironment": false,
				"python.testing.unittestEnabled": false,
				"python.testing.nosetestsEnabled": false,
				"python.testing.pytestEnabled": true,
				"python.testing.pytestPath": ".venv/bin/pytest",
				"python.testing.pytestArgs": [
					"--cov-append",
					"--cov=opsiconfd",
					"--cov-report=xml",
					"tests"
				],
				"mypy-type-checker.path": [
					".venv/bin/mypy"
				],
				"mypy-type-checker.args": [
					"--show-error-codes"
				],
				"ruff.interpreter": [
					"${workspaceFolder}/.venv/bin/python"
				]
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ryanluker.vscode-coverage-gutters",
				"ms-python.mypy-type-checker",
				"charliermarsh.ruff"
			],
			"chat.promptFiles": true,
			"chat.promptFilesLocations": {
				".github/prompts": true
			},
			"chat.instructionsFilesLocations": {
				".github/instructions": true
			},
			"github.copilot.chat.codeGeneration.instructions": [
				{
					"file": ".github/instructions/python-coding-style.instructions.md"
				}
			],
			"github.copilot.chat.commitMessageGeneration.instructions": [
				{
					"file": ".github/instructions/git-commit-message.instructions.md"
				}
			],
			"github.copilot.chat.reviewSelection.enabled": true,
			"github.copilot.chat.reviewSelection.instructions": [
				{
					"file": ".github/instructions/python-coding-style.instructions.md"
				}
			],
			"github.copilot.chat.testGeneration.instructions": [
				{
					"file": ".github/instructions/pytest.instructions.md"
				}
			]
		}
	}
}